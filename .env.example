# Django
SECRET_KEY=
DEBUG=

# Database (set DB_ENGINE to sqlite3 for local dev, postgresql for production)
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Host port that PostgreSQL is exposed on (defaults to DB_PORT). Set to a
# non-default value to avoid a clash with a local Postgres, or to expose it
# to external tools (e.g. 54321:5432 to connect from outside the compose net).
DB_PORT_EXTERNAL=

# Hosts (comma-separated; use your domain in production)
ALLOWED_HOSTS=

# Server (Gunicorn bind address and exposed port)
GUNICORN_BIND=
WEB_PORT=

# Optional: set to 1 to seed demo data on first start
SEED=1
