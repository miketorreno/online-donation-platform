# Django
SECRET_KEY=
DEBUG=

# Database (set DB_ENGINE to sqlite3 for local dev, postgresql for production)
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Hosts (comma-separated; use your domain in production)
ALLOWED_HOSTS=

# Server (Gunicorn bind address and exposed port)
GUNICORN_BIND=
WEB_PORT=

# Gunicorn worker count. Use >1 in production
GUNICORN_WORKERS=3

# Gunicorn request timeout (s)
GUNICORN_TIMEOUT=120

# Host directories bind-mounted into the web container so the host-level
# Nginx reverse proxy can serve static files and uploaded media. Absolute
# paths recommended in production; relative paths resolve from the compose dir.
HOST_STATIC_DIR=./staticfiles
HOST_MEDIA_DIR=./media

# Celery / Redis broker (points at the `redis` compose service in prod)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email. Default is a local file backend (writes .eml to odp/emails) for dev;
# set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and the host
# credentials below for real delivery.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional: set to 1 to seed demo data on first start
SEED=1
